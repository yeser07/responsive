PORT=3000
MONGO_URI=mongodb://localhost:27017/responsive
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SEED_DEFAULT_ADMIN=true
REQUIRE_SECRETS=false
AUTH_RATE_LIMIT=30
NODE_ENV=development

# Optional OIDC / enterprise SSO
SSO_ENABLED=false
SSO_PROVIDER_NAME=OIDC
SSO_AUTHORIZATION_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback
SSO_SCOPES=openid profile email
SSO_DEFAULT_ROLE=viewer
